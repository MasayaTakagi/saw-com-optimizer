+  const actual = await importOriginal<typeof import("node:fs")>();
+  return {
+    ...actual,
+    openSync: vi.fn((file: unknown, ...args: unknown[]) => {
+      const descriptor = actual.openSync(file as string, ...(args as [any, ...any[]]));
+      if (String(file) === policyMockState.lockPath) {
+        policyMockState.descriptors.set(descriptor, String(file));
