# Python cache
**/__pycache__/
**/*.pyc
.pytest_cache/

# VCS metadata and environment secrets
.git/
.env
.env.*

# Virtual environments
.venv/
venv/

# Large/generated temporary files
tmp/
cache/

# Review archives / binary bundles
runs/**/*.zip
**/*.zip

# Potentially large raw optimizer outputs
runs/**/raw/
runs/**/checkpoints/
runs/**/*.ckpt
runs/**/*.checkpoint

# Temporary data
temp/

# Local/private material
private/
secrets/
credentials/
confidential/

# Licensed or redistribution-restricted references
references/licensed/
