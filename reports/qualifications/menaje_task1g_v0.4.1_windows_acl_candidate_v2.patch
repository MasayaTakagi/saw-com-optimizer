index 0000000..2b0407b
--- /dev/null
+++ b/scripts/verify-private-state-acl.ps1
@@ -0,0 +1,148 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = "Stop"
+$Path = $env:MENAJE_PRIVATE_STATE_PATH
+$Kind = $env:MENAJE_PRIVATE_STATE_KIND
+$AllowMissingTail = $env:MENAJE_PRIVATE_STATE_ALLOW_MISSING_TAIL -eq "1"
+if ([string]::IsNullOrWhiteSpace($Path) -or $Kind -notin @("File", "Directory")) {
+  throw "Private state ACL helper received invalid parameters."
+}
+$windowsPowerShellExe = "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
+$securityModule = "C:\Windows\System32\WindowsPowerShell\v1.0\Modules\Microsoft.PowerShell.Security\Microsoft.PowerShell.Security.psd1"
+Import-Module -Name $securityModule -ErrorAction Stop
+
+$systemSid = "S-1-5-18"
+$administratorsSid = "S-1-5-32-544"
+$trustedInstallerSid = "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464"
+$currentUserSid = [System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value
+$trustedSids = @($systemSid, $administratorsSid, $trustedInstallerSid, $currentUserSid)
+$trustedSystemOwners = @($systemSid, $administratorsSid, $trustedInstallerSid)
+$traverseAndSynchronize = [uint32]0x00100020
+$mutationMask = [uint32](0x00000002 -bor 0x00000004 -bor 0x00000010 -bor 0x00000040 -bor
+  0x00000100 -bor 0x00010000 -bor 0x00040000 -bor 0x00080000 -bor 0x10000000 -bor 0x40000000)
+
+function Get-AccessMask([System.Security.AccessControl.FileSystemRights]$Rights) {
+  return [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$Rights), 0)
+}
+
+function Assert-TrustedOwnerAndAcl([string]$Candidate, [bool]$IsDirectory, [bool]$IsPrivateRoot) {
+  $acl = Get-Acl -LiteralPath $Candidate -ErrorAction Stop
+  $ownerSid = $acl.GetOwner([System.Security.Principal.SecurityIdentifier]).Value
+  if ($ownerSid -notin $trustedSids) {
+    throw "Private state path has an untrusted owner SID."
+  }
+  $sddl = $acl.GetSecurityDescriptorSddlForm([System.Security.AccessControl.AccessControlSections]::Access)
+  if ($sddl -match "NO_ACCESS_CONTROL" -or @($acl.Access).Count -eq 0) {
+    throw "Private state path has a missing or null DACL."
+  }
+
+  foreach ($rule in $acl.Access) {
+    if ($rule.AccessControlType -ne [System.Security.AccessControl.AccessControlType]::Allow) { continue }
+    $sid = $rule.IdentityReference.Translate([System.Security.Principal.SecurityIdentifier]).Value
+    if ($sid -in $trustedSids) { continue }
+    $mask = Get-AccessMask $rule.FileSystemRights
+    if ($IsPrivateRoot -and $IsDirectory -and
+        ($rule.InheritanceFlags -ne [System.Security.AccessControl.InheritanceFlags]::None -or
+         $rule.PropagationFlags -ne [System.Security.AccessControl.PropagationFlags]::None)) {
+      throw "Private state root has an untrusted inheritable allow ACE: $Candidate; $sid; $mask."
+    }
+    if ($IsPrivateRoot -and $IsDirectory -and
+        ($mask -band $traverseAndSynchronize) -eq $mask -and
+        $rule.InheritanceFlags -eq [System.Security.AccessControl.InheritanceFlags]::None -and
+        $rule.PropagationFlags -eq [System.Security.AccessControl.PropagationFlags]::None) {
+      continue
+    }
+    if (-not $IsPrivateRoot -and $IsDirectory -and ($mask -band $mutationMask) -eq 0) {
+      continue
+    }
+    throw "Private state path has an allow ACE outside the trusted SID boundary: $Candidate; $sid; $mask."
+  }
+}
+
+function Assert-TrustedSystemFile([string]$Candidate) {
+  $attributes = [System.IO.File]::GetAttributes($Candidate)
+  if (($attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0 -or
+      ($attributes -band [System.IO.FileAttributes]::Directory) -ne 0) {
+    throw "Windows ACL verifier executable or module is not a regular file."
+  }
+  $acl = Get-Acl -LiteralPath $Candidate -ErrorAction Stop
+  $ownerSid = $acl.GetOwner([System.Security.Principal.SecurityIdentifier]).Value
+  if ($ownerSid -notin $trustedSystemOwners) {
+    throw "Windows ACL verifier file has an untrusted owner SID."
+  }
+  $sddl = $acl.GetSecurityDescriptorSddlForm([System.Security.AccessControl.AccessControlSections]::Access)
+  if ($sddl -match "NO_ACCESS_CONTROL" -or @($acl.Access).Count -eq 0) {
+    throw "Windows ACL verifier file has a missing or null DACL."
+  }
+  foreach ($rule in $acl.Access) {
+    if ($rule.AccessControlType -ne [System.Security.AccessControl.AccessControlType]::Allow) { continue }
+    $mask = Get-AccessMask $rule.FileSystemRights
+    $sid = $rule.IdentityReference.Value
+    try {
+      $sid = $rule.IdentityReference.Translate([System.Security.Principal.SecurityIdentifier]).Value
+    } catch {
+      # Unresolved read-only application principals are harmless here; write rights fail below.
+    }
+    if ($sid -in $trustedSystemOwners) { continue }
+    if (($mask -band $mutationMask) -ne 0) {
+      throw "Windows ACL verifier file is writable outside the trusted OS boundary."
+    }
+  }
+  $signature = Get-AuthenticodeSignature -LiteralPath $Candidate -ErrorAction Stop
+  if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid -or
+      $signature.SignerCertificate.Subject -notlike "CN=Microsoft Windows,*") {
+    throw "Windows ACL verifier executable or module lacks a valid Microsoft Windows signature."
+  }
+}
+
+Assert-TrustedSystemFile $windowsPowerShellExe
+Assert-TrustedSystemFile $securityModule
+$fullPath = [System.IO.Path]::GetFullPath($Path)
+$volumeRoot = [System.IO.Path]::GetPathRoot($fullPath)
+if ([string]::IsNullOrWhiteSpace($volumeRoot)) {
+  throw "Private state path is not rooted."
+}
+$isFileTarget = $Kind -eq "File"
+$privateRootPath = if ($isFileTarget) { [System.IO.Path]::GetDirectoryName($fullPath) } else { $fullPath }
+$relative = $fullPath.Substring($volumeRoot.Length).Trim([char[]]@([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar))
+$parts = @($relative.Split([char[]]@([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar), [System.StringSplitOptions]::RemoveEmptyEntries))
+$current = $volumeRoot
+$checked = [System.Collections.Generic.List[string]]::new()
+
+if ([System.IO.Directory]::Exists($volumeRoot)) {
+  Assert-TrustedOwnerAndAcl $volumeRoot $true $false
+  $checked.Add($volumeRoot)
+}
+
+for ($index = 0; $index -lt $parts.Count; $index++) {
+  $current = [System.IO.Path]::Combine($current, $parts[$index])
+  $isTarget = $index -eq ($parts.Count - 1)
+  $isPrivateRoot = [string]::Equals($current, $privateRootPath, [System.StringComparison]::OrdinalIgnoreCase)
+  $attributes = $null
+  try {
+    $attributes = [System.IO.File]::GetAttributes($current)
+  } catch [System.IO.FileNotFoundException] {
+    if ($AllowMissingTail) { break }
+    throw "Private state path component is missing."
+  } catch [System.IO.DirectoryNotFoundException] {
+    if ($AllowMissingTail) { break }
+    throw "Private state path component is missing."
+  }
+  if (($attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
+    throw "Private state path contains a reparse point."
+  }
+  $isDirectory = ($attributes -band [System.IO.FileAttributes]::Directory) -ne 0
+  if ($isTarget -and (($Kind -eq "Directory") -ne $isDirectory)) {
+    throw "Private state path has the wrong object type."
+  }
+  if (-not $isTarget -and -not $isDirectory) {
+    throw "Private state path has a non-directory ancestor."
+  }
+  Assert-TrustedOwnerAndAcl $current $isDirectory $isPrivateRoot
+  $checked.Add($current)
+}
+
+[pscustomobject]@{
+  ok = $true
+  currentUserSid = $currentUserSid
+  checkedPaths = @($checked)
+} | ConvertTo-Json -Compress -Depth 4
