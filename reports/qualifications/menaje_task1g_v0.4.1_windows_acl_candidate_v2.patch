+function addUntrustedAllowAce(
+  target: string,
+  rights: string,
+  inheritance = "None",
+  propagation = "None"
+): void {
+  const powershell = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
+  const securityModule =
+    "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\Modules\\Microsoft.PowerShell.Security\\Microsoft.PowerShell.Security.psd1";
+  const script = [
+    "$ErrorActionPreference = 'Stop'",
+    "Import-Module -Name '" + securityModule + "' -ErrorAction Stop",
+    "$acl = Get-Acl -LiteralPath $env:MENAJE_TEST_ACL_PATH",
+    "$sid = New-Object System.Security.Principal.SecurityIdentifier('S-1-5-32-545')",
+    "$rights = [System.Enum]::Parse([System.Security.AccessControl.FileSystemRights], $env:MENAJE_TEST_ACL_RIGHTS)",
+    "$inheritance = [System.Enum]::Parse([System.Security.AccessControl.InheritanceFlags], $env:MENAJE_TEST_ACL_INHERITANCE)",
+    "$propagation = [System.Enum]::Parse([System.Security.AccessControl.PropagationFlags], $env:MENAJE_TEST_ACL_PROPAGATION)",
+    "$rule = [System.Security.AccessControl.FileSystemAccessRule]::new($sid, $rights, $inheritance, $propagation, [System.Security.AccessControl.AccessControlType]::Allow)",
+    "$acl.AddAccessRule($rule) | Out-Null",
+    "Set-Acl -LiteralPath $env:MENAJE_TEST_ACL_PATH -AclObject $acl"
+  ].join("; ");
+  const result = spawnSync(powershell, [
+    "-NoLogo",
+    "-NoProfile",
+    "-NonInteractive",
+    "-Command",
+    script
+  ], {
+    encoding: "utf8",
+    env: {
+      SystemRoot: "C:\\Windows",
+      WINDIR: "C:\\Windows",
+      PATH: "C:\\Windows\\System32",
+      PSModulePath: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\Modules",
+      MENAJE_TEST_ACL_PATH: target,
+      MENAJE_TEST_ACL_RIGHTS: rights,
+      MENAJE_TEST_ACL_INHERITANCE: inheritance,
+      MENAJE_TEST_ACL_PROPAGATION: propagation
+    },
+    timeout: 10_000,
+    windowsHide: true
+  });
+  if (result.error || result.status !== 0) {
+    throw new Error("Could not prepare disposable ACL fixture: " + (result.error?.message || result.stderr));
+  }
+}
